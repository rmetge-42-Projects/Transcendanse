# ==============================================================================
# EXEMPLE DE CONFIGURATION - PROJET TRANSCENDENCE
# ==============================================================================
# Instructions :
# 1. Copiez ce fichier sur votre ordinateur et renommez-le en ".env"
# 2. Remplacez les valeurs ci-dessous par vos identifiants locaux
# 3. LE FICHIER .env NE DOIT JAMAIS ÊTRE COMMITÉ SUR GIT !
# ==============================================================================

# --- HASHICORP VAULT (Gestion des secrets) ---
# Jeton d'administration initial pour configurer Vault
JWT_SECRET=secret_jeton_que_toi_veux
VAULT_ADDR=http://vault:8200
DB_USER=nom_user_que_toi_veux
DB_PASSWORD=mdp_que_toi_veux
DB_NAME=transcendence_db_mais_fais_ce_que_tu_veux

