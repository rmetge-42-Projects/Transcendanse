import { UsersService } from './users.service';
import { PrismaService } from '../prisma/prisma.service';
import { MessageGateway } from '../message/message.gateway';
import { UpdateProfileDto } from './dto/updateProfile.dto';

describe('Suggestion invalidation after profile changes', () => {
  const update = jest.fn();
  const notifySuggestionsChanged = jest.fn();
  const service = new UsersService(
    { user: { update } } as unknown as PrismaService,
    { notifySuggestionsChanged } as unknown as MessageGateway,
  );

  beforeEach(() => {
    jest.clearAllMocks();
    update.mockResolvedValue({ id: 1 });
  });

  it.each([{ orientation: 'woman' }, { kind: 'man' }])(
    'notifies viewers after saving compatibility changes: %j',
    async (profile) => {
      await service.updateProfile(1, profile as UpdateProfileDto);
      expect(notifySuggestionsChanged).toHaveBeenCalledTimes(1);
      expect(update.mock.invocationCallOrder[0]).toBeLessThan(
        notifySuggestionsChanged.mock.invocationCallOrder[0],
      );
    },
  );

  it('does not notify viewers when saving fails', async () => {
    update.mockRejectedValueOnce(new Error('Database unavailable'));
    await expect(service.updateProfile(1, { orientation: 'woman' } as UpdateProfileDto)).rejects.toThrow();
    expect(notifySuggestionsChanged).not.toHaveBeenCalled();
  });

  it('does not invalidate suggestions for biography-only changes', async () => {
    await service.updateProfile(1, { biography: 'Hello' } as UpdateProfileDto);
    expect(notifySuggestionsChanged).not.toHaveBeenCalled();
  });
});

