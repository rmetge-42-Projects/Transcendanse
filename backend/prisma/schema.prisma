// Fichier de shema prisma

//genere le dossier qui va contenir toute les fonctions adapter

generator client {
  provider = "prisma-client-js"
}

//donne le type de base et ladresse de la base

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

//utilisateur type

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}